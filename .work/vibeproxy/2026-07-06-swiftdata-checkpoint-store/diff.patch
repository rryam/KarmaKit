+      consent: .notRequired
+    ) == .denied(.missingConsent(.computerUse)))
+    let requirement = automationGate.consentRequirement(
+      for: .computerUse(actionID: "click-toolbar-save")
+    )
+    #expect(automationGate.evaluate(
+      .computerUse(actionID: "click-toolbar-save"),
