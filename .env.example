# CoreAgent local development environment template
# Copy to .env and fill in values only for optional live provider testing.
# Never commit .env — it is gitignored.

# Anthropic Claude (only needed for live Claude integration tests)
ANTHROPIC_API_KEY=

# Generic Chat Completions client (Apple utilities provider)
COREAGENT_CHAT_COMPLETIONS_BASE_URL=https://example.invalid/v1
COREAGENT_CHAT_COMPLETIONS_API_KEY=

# Firebase / Gemini (only needed for live Firebase integration tests)
GOOGLE_APPLICATION_CREDENTIALS=

# CI / local tooling (optional)
SWIFTLINT_STRICT=1
COREAGENT_COVERAGE_THRESHOLD=60
